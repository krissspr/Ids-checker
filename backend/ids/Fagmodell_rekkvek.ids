          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Rekkverk" />
              <xs:enumeration value="Rekkverksavslutning" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:property cardinality="required" instructions="iht. R761 og R762" dataType="IFCTEXT">
          <ids:propertySet>
            <ids:simpleValue>Prosessinformasjon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Element</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
