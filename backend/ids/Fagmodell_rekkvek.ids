            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required" instructions="iht. R761 og R762" dataType="IFCTEXT">
          <ids:propertySet>
            <ids:simpleValue>Prosessinformasjon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Sted</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".+" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required" instructions="iht. R761 og R762" dataType="IFCTEXT">
          <ids:propertySet>
            <ids:simpleValue>Prosessinformasjon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Prosessnummer</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="75.21" />
              <xs:enumeration value="75.221" />
              <xs:enumeration value="75.222" />
              <xs:enumeration value="75.227" />
              <xs:enumeration value="75.231" />
              <xs:enumeration value="75.232" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required" instructions="iht. R761 og R762" dataType="IFCTEXT">
          <ids:propertySet>
            <ids:simpleValue>Prosessinformasjon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Prosessnavn</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Rekkverk av tre" />
              <xs:enumeration value="Rekkverk av plasstøpt betong" />
              <xs:enumeration value="Rekkverk av prefabrikert betongelementer" />
              <xs:enumeration value="Flere" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required" instructions="iht. R761 og R762" dataType="IFCTEXT">
          <ids:propertySet>
            <ids:simpleValue>Prosessinformasjon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Enhet</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="m" />
              <xs:enumeration value="Stk" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required" instructions="iht. R761 og R762" dataType="IFCINTEGER">
          <ids:propertySet>
            <ids:simpleValue>Prosessinformasjon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Mengde</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:integer">
              <xs:minExclusive value="0" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
